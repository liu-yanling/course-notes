FROM node:22-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 python3-venv python3-pip \
  && rm -rf /var/lib/apt/lists/* \
  && python3 -m venv /opt/venv \
  && /opt/venv/bin/pip install --no-cache-dir python-docx

WORKDIR /app
COPY web ./web
COPY server/local-summary.mjs ./server/local-summary.mjs
COPY apps/dsh-video-coursemap ./apps/dsh-video-coursemap

ENV NODE_ENV=production
ENV PORT=10000
ENV COURSE_NOTES_PYTHON=/opt/venv/bin/python3

EXPOSE 10000
USER node
CMD ["node", "web/server.mjs"]
